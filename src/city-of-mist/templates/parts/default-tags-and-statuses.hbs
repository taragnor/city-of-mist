<section class="default-tags-and-statuses">
  <h2>
    {{localize "Generic.terms.defaultTagsAndStatuses"}}
    {{#if (not actor.system.locked)}}
    <a class="create-default">
      <i class="fas fa-plus-square"></i>
    </a>
    {{/if}}
    <a class="refresh" title="{{localize 'CityOfMist.command.refreshDefaultTagsAndStatus'}}">
      <i class="fa-solid fa-arrow-rotate-left"></i>
    </a>
  </h2>
  <div class="list">
    {{#each actor.system.defaultTags as |tag i|}}
    <div class="list-item default-tag" data-type="{{tag.type}}" data-index="{{i}}">
      {{#if tag.hidden}}
      <span>
        <a title='{{localize "Generic.term.hidden"}}' >
          <i class="fa-solid fa-eye"></i>
        </a>
      </span>
      {{/if}}
      <input class="default-tag" type="text" value="{{tag.name}}" >
    </div>
      {{/each}}

    {{#each actor.system.defaultStatuses as |status i|}}
    <div class="list-item default-status" data-type="{{status.type}}" data-index="{{i}}">
      {{#if status.hidden}}
      <span>
        <a title='{{localize "Generic.term.hidden"}}' >
          <i class="fa-solid fa-eye"></i>
        </a>
      </span>
      {{/if}}
      <input class="default-status" type="text" value="{{status.name}}-{{status.tier}}" >
    </div>
      {{/each}}
  </div>
</section>
